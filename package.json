{
  "name": "smarter-faster-better-mcp",
  "version": "0.10.2",
  "description": "Blazing fast AST-based MCP code search using OXC with optional Tree-sitter polyglot parsing",
  "keywords": [
    "mcp",
    "bun",
    "typescript",
    "ast",
    "tree-sitter",
    "search",
    "ai"
  ],
  "homepage": "https://github.com/iHaiduk/smarter-faster-better-mcp#readme",
  "bugs": {
    "url": "https://github.com/iHaiduk/smarter-faster-better-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iHaiduk/smarter-faster-better-mcp.git"
  },
  "license": "MIT",
  "author": "Igor Haiduk",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "smarter-faster-better-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "AGENTS.template.md"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target node --format esm --packages=external && bun build src/bin/test-scout.ts --outdir dist/bin --target node --format esm --packages=external",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run check && npm run build",
    "prepublishOnly": "npm run check && npm run build && npm run verify:pack",
    "scout": "bun run src/bin/test-scout.ts cache",
    "scout:summary": "bun run src/bin/test-scout.ts cache --summary",
    "test": "bun test",
    "verify:pack": "node ./scripts/verify-packed-entry.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@repomix/tree-sitter-wasms": "0.1.17",
    "@typesafe-ai/sdk": "0.7.0",
    "chokidar": "5.0.0",
    "dotenv": "18.0.8",
    "oxc-parser": "0.154.0",
    "ts-morph": "28.0.0",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2"
  }
}
